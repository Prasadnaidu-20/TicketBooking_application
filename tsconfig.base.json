{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext", //This option specifies how TypeScript should resolve modules. The "NodeNext" value indicates that TypeScript should use the Node.js module resolution strategy, which is suitable for projects that use Node.js-style imports and exports.

    "strict": true, //Enables all strict type-checking options. This is a good practice to catch potential errors and improve code quality.
    "noUncheckedIndexedAccess": true, //This flag enables strict checking of indexed access types, ensuring that you handle cases where an index may not exist in an object or array. It helps prevent runtime errors related to accessing undefined properties.
    "exactOptionalPropertyTypes": true, //This flag ensures that optional properties in TypeScript interfaces and types are treated as exactly optional, meaning that they can only be assigned undefined or omitted entirely. This helps catch potential issues where optional properties might be assigned unexpected values.
    "noImplicitOverride": true, //This flag ensures that when you override a method in a subclass, you must explicitly use the "override" keyword. This helps catch potential errors where a method is unintentionally overridden without the developer's knowledge.

    "verbatimModuleSyntax": true, //If you try to write "dishonest" imports, the compiler will catch it immediately

    "forceConsistentCasingInFileNames": true, //By adding this flag to your base configuration, TypeScript forces Windows and Mac computers to act like case-sensitive Linux machines during compilation.
    "skipLibCheck": true, //This flag tells TypeScript to skip type checking of all declaration files (*.d.ts). This can significantly speed up the compilation process, especially in large projects with many dependencies.

    "noEmit": true //This flag tells TypeScript not to emit any output files during the compilation process. It is often used in projects where TypeScript is used for type checking and development purposes, but the actual output is generated by another tool or build process.
  }
}
